# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=syncerp_dev_secret_change_in_production
JWT_EXPIRES=8h

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev & Docker)
# DB_PATH is relative to the backend directory when not set
# DB_PATH=./syncerp.db

# When using Docker with a volume mount, override to:
# DB_PATH=/app/data/syncerp.db

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin (comma-separated for multiple)
# Local dev: leave as * or set to http://localhost:3000
# Production: set to your deployed frontend URL
CORS_ORIGIN=http://localhost:3000

# ─── Production overrides (Render / Railway) ──────────────────────────────────
# NODE_ENV=production
# CORS_ORIGIN=https://syncerp.vercel.app
# DB_PATH=/data/syncerp.db
