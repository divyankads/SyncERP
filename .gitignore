# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
build/
frontend/dist/
backend/dist/

# ─── Environment (NEVER commit real secrets) ──────────────────────────────────
.env
.env.local
.env.production
.env.staging
# .env.example is intentionally NOT ignored — it documents required vars

# ─── Database (SQLite files contain live data) ────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─── Docker ───────────────────────────────────────────────────────────────────
# docker-compose.override.yml    # uncomment if you use local overrides

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel/

# ─── Temporary / test files ───────────────────────────────────────────────────
*.tmp
coverage/
