              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"type\": \"call\",\n  \"notes\": \"Discussed Q3 bulk order. Customer needs 200 units of SKU-001.\",\n  \"status\": \"pending\",\n  \"follow_date\": \"2026-08-05\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/crm", "host": ["{{base_url}}"], "path": ["api","crm"] }
          }
