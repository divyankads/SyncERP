          "name": "List Purchase Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/purchase-orders", "host": ["{{base_url}}"], "path": ["api","purchase-orders"] }
          }
        },
        {
          "name": "Get PO Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/purchase-orders/1", "host": ["{{base_url}}"], "path": ["api","purchase-orders","1"] }
          }
        },
        {
