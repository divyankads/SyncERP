          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 10000\n}" },
            "url": { "raw": "{{base_url}}/api/invoices/1/payment", "host": ["{{base_url}}"], "path": ["api","invoices","1","payment"] }
          }
        }
      ]
    },
    {
      "name": "CRM Follow-ups",
      "item": [
        {
          "name": "List Follow-ups",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/crm", "host": ["{{base_url}}"], "path": ["api","crm"],
              "query": [
                { "key": "status", "value": "pending", "disabled": true }
              ]
