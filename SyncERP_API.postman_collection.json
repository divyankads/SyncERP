          "name": "List Invoices",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/invoices", "host": ["{{base_url}}"], "path": ["api","invoices"],
              "query": [
                { "key": "status",      "value": "unpaid", "disabled": true },
                { "key": "customer_id", "value": "1",      "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Invoice Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/invoices/1", "host": ["{{base_url}}"], "path": ["api","invoices","1"] }
          }
        },
