            "body": { "mode": "raw", "raw": "{\n  \"status\": \"received\"\n}" },
            "url": { "raw": "{{base_url}}/api/purchase-orders/1/status", "host": ["{{base_url}}"], "path": ["api","purchase-orders","1","status"] }
          }
        }
      ]
    },
    {
      "name": "Invoices",
